DATABASE_URL="postgresql://ballot_runtime:password@host:5432/postgres?sslmode=require&schema=ballotveyra"
DIRECT_URL="postgresql://ballot_migrator:password@host:5432/postgres?sslmode=require&schema=ballotveyra"
DATABASE_POOL_MAX="10"
APP_ORIGIN="http://localhost:3000"
VOTER_SESSION_SECRET="replace-with-at-least-32-random-characters"
INVITE_HMAC_KEYS="1:replace-with-a-long-random-secret"
INVITE_ACTIVE_KEY_VERSION="1"
