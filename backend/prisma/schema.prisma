generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
  schemas      = ["ballotveyra"]
}


enum WorkspaceRole {
  OWNER
  MANAGER
  OBSERVER

  @@schema("ballotveyra")
}

enum ElectionStatus {
  DRAFT
  SCHEDULED
  CLOSED
  PUBLISHED
  CANCELLED

  @@schema("ballotveyra")
}

enum ResultVisibility {
  WORKSPACE
  PUBLIC

  @@schema("ballotveyra")
}

model OrganizerProfile {
  id            String          @id @default(cuid())
  email         String          @unique
  firstName     String?
  lastName      String?
  passwordHash  String?
  emailVerified Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  memberships   WorkspaceMember[]

  @@map("OrganizerProfile")
  @@schema("ballotveyra")
}

model Workspace {
  id        String            @id @default(cuid())
  slug      String            @unique
  name      String
  createdAt DateTime          @default(now())
  members   WorkspaceMember[]
  elections Election[]
  events    AuditEvent[]

  @@map("Workspace")
  @@schema("ballotveyra")
}

model WorkspaceMember {
  workspaceId String           
  organizerId String           
  role        WorkspaceRole
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  organizer   OrganizerProfile @relation(fields: [organizerId], references: [id], onDelete: Restrict)

  @@id([workspaceId, organizerId])
  @@index([organizerId])
  @@map("WorkspaceMember")
  @@schema("ballotveyra")
}

model Election {
  id            String          @id @default(cuid())
  workspaceId   String
  slug          String          @unique
  title         String
  description   String?
  status        ElectionStatus  @default(DRAFT)
  timeZone      String          @default("Africa/Lagos")
  opensAt       DateTime?
  closesAt      DateTime?
  endedEarlyAt  DateTime?
  eligibleCount Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  options       BallotOption[]
  voters        EligibleVoter[]
  imports       ImportBatch[]
  result        ResultSnapshot?
  events        AuditEvent[]
  ballots       Ballot[]

  @@index([workspaceId, createdAt, id])
  @@map("Election")
  @@schema("ballotveyra")
}

model BallotOption {
  id          String   @id @default(cuid())
  electionId  String
  label       String
  description String?
  position    Int
  election    Election @relation(fields: [electionId], references: [id], onDelete: Restrict)
  ballots     Ballot[]

  @@unique([electionId, id])
  @@unique([electionId, position])
  @@map("BallotOption")
  @@schema("ballotveyra")
}

model EligibleVoter {
  id          String   @id @default(cuid())
  electionId  String
  voterKey    String
  phone       String?  @db.VarChar(32)
  displayName String?
  tokenDigest String?  @unique
  keyVersion  Int?
  redeemed    Boolean  @default(false)
  election    Election @relation(fields: [electionId], references: [id], onDelete: Restrict)

  @@unique([electionId, voterKey])
  @@unique([electionId, phone])
  @@index([electionId, id])
  @@map("EligibleVoter")
  @@schema("ballotveyra")
}

model Ballot {
  id         String       @id @default(cuid())
  electionId String
  optionId   String
  election   Election     @relation(fields: [electionId], references: [id], onDelete: Restrict)
  option     BallotOption @relation(fields: [electionId, optionId], references: [electionId, id], onDelete: Restrict)

  @@index([electionId, optionId])
  @@map("Ballot")
  @@schema("ballotveyra")
}

model ImportBatch {
  electionId String
  batchKey   String   @default(cuid())
  digest     String
  summary    Json
  createdAt  DateTime @default(now())
  election   Election @relation(fields: [electionId], references: [id], onDelete: Restrict)

  @@id([electionId, batchKey])
  @@map("ImportBatch")
  @@schema("ballotveyra")
}

model ResultSnapshot {
  electionId  String           @id
  visibility  ResultVisibility @default(WORKSPACE)
  tally       Json
  publishedAt DateTime         @default(now())
  publishedBy String
  election    Election         @relation(fields: [electionId], references: [id], onDelete: Restrict)

  @@map("ResultSnapshot")
  @@schema("ballotveyra")
}

model AuditEvent {
  id          String     @id @default(cuid())
  workspaceId String
  electionId  String?
  actorId     String
  action      String
  metadata    Json?
  createdAt   DateTime   @default(now())
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  election    Election?  @relation(fields: [electionId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt, id])
  @@index([electionId, createdAt, id])
  @@map("AuditEvent")
  @@schema("ballotveyra")
}
